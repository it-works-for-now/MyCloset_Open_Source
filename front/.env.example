VITE_API_BASE_URL=http://localhost:8080/api
# Set to mock only when developing the garment form without the Backend API.
VITE_GARMENT_ANALYSIS_MODE=backend

# FitLog mode: auto uses backend when VITE_API_BASE_URL exists, otherwise mock.
# Use mock for frontend-only testing, backend for API integration.
VITE_FIT_LOG_MODE=auto
