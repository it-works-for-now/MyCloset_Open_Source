HOST=0.0.0.0
PORT=8001
LOG_LEVEL=info
AI_API_KEY=

HF_HOME=.model-cache
LOCAL_FILES_ONLY=false

# --- 의류 분석 (Qwen2.5-VL) ---
ANALYSIS_MODEL_ID=Qwen/Qwen2.5-VL-3B-Instruct
ANALYSIS_LOAD_IN_4BIT=true
ANALYSIS_DEVICE=cuda
ANALYSIS_MAX_NEW_TOKENS=192
ANALYSIS_MAX_SIDE=768

# --- 코디 추천 (Qwen3) ---
RECOMMEND_MODEL_ID=Qwen/Qwen3-4B-Instruct-2507
RECOMMEND_LOAD_IN_4BIT=true
RECOMMEND_MAX_NEW_TOKENS=512
RECOMMEND_MAX_RESULTS=2

# Select one: sana_1_5 (default), realvisxl_lightning, realvisxl_fast, dreamshaper, or custom.
# Presets override the IMAGE_* values below; use custom to tune them manually.
# --- 착장 이미지 생성 (SANA 1.5) ---
IMAGE_MODEL_PRESET=sana_1_5

IMAGE_MODEL_ID=Efficient-Large-Model/SANA1.5_1.6B_1024px_diffusers
IMAGE_MODEL_LOCAL_PATH=
IMAGE_MODEL_VARIANT=
IMAGE_STEPS=24
IMAGE_CFG=5.0
IMAGE_WIDTH=768
IMAGE_HEIGHT=1152
IMAGE_OFFLOAD=true
# SANA quality settings. Presets override these values; use custom for manual tuning.
IMAGE_SANA_PAG_SCALE=2.0
IMAGE_SANA_PAG_ADAPTIVE_SCALE=0.0
IMAGE_SANA_MAX_SEQUENCE_LENGTH=300
IMAGE_SANA_USE_COMPLEX_HUMAN_INSTRUCTION=true
ENABLE_WARMUP=true

# Optional single-clothing reference for the SDXL IP-Adapter; SANA currently uses clothing metadata only.
IMAGE_REFERENCE_ENABLED=false
IMAGE_REFERENCE_SCALE=0.55
IMAGE_REFERENCE_ADAPTER_REPO=h94/IP-Adapter
IMAGE_REFERENCE_ADAPTER_SUBFOLDER=sdxl_models
IMAGE_REFERENCE_ADAPTER_WEIGHT=ip-adapter-plus_sdxl_vit-h.safetensors
IMAGE_REFERENCE_ADAPTER_IMAGE_ENCODER_FOLDER=models/image_encoder
IMAGE_REFERENCE_ALLOWED_HOSTS=
IMAGE_REFERENCE_ALLOWED_PORTS=80,443,8080
IMAGE_REFERENCE_PATH_PREFIX=/uploads/clothes/
IMAGE_REFERENCE_TIMEOUT_SECONDS=10
IMAGE_REFERENCE_MAX_BYTES=10485760
IMAGE_REFERENCE_MAX_PIXELS=16000000

# Requires an SDXL image model. SANA turns this off and uses prompt-only composition.
IMAGE_CONTROLNET_ENABLED=false
IMAGE_CONTROLNET_MODEL_ID=xinsir/controlnet-openpose-sdxl-1.0
IMAGE_CONTROLNET_SCALE=0.8
